# 模型网关：可切换到任意 OpenAI 兼容接口（内网模型、vLLM、SGLang 等）
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=120

# 存储：开发用 SQLite，现场切 PostgreSQL + pgvector
DATABASE_URL=sqlite:///data/app.db
VECTOR_BACKEND=sqlite
EMBEDDING_DIM=1024
MAX_UPLOAD_MB=30

# 检索
RETRIEVAL_MODE=hybrid

# 诊断数据集与 MCP 工具服务（留空使用默认 ../remotediag）
DIAGNOSTIC_DIR=
MCP_COMMAND=python mcp_server.py

# 保修与到场时限的评估基准日
REFERENCE_DATE=2026-07-31

# 初始账号
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=admin_change_me
SESSION_DAYS=7

# 本地 OCR 环境
OCR_PYTHON=D:\PaddleOCR\venv\Scripts\python.exe
OCR_HOME=D:\PaddleOCR\models
OCR_CACHE=D:\PaddleOCR\cache

# 本地 Embedding 环境
BGE_PYTHON=D:\BGE-M3\venv\Scripts\python.exe
BGE_MODEL_PATH=D:\BGE-M3\models\bge-m3
BGE_CACHE=D:\BGE-M3\cache
